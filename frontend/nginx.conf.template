server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    resolver 127.0.0.11 ipv6=off valid=30s;
    set $api_upstream api:8000;

    location = /auth/login {
        auth_basic "Novel AI Access";
        auth_basic_user_file /etc/nginx/.htpasswd;
        error_page 401 = @auth_failed;

        add_header Set-Cookie "novel_ai_access=__NOVEL_AI_WEB_SESSION_TOKEN__; Path=/; Max-Age=2592000; SameSite=Lax; HttpOnly";
        add_header Cache-Control "no-store";

        proxy_pass http://$api_upstream/healthz;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location = /auth/session {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        if ($cookie_novel_ai_access != "__NOVEL_AI_WEB_SESSION_TOKEN__") {
            return 401 '{"detail":"AUTH_REQUIRED"}';
        }
        return 204;
    }

    location = /auth/logout {
        add_header Set-Cookie "novel_ai_access=; Path=/; Max-Age=0; SameSite=Lax; HttpOnly" always;
        add_header Cache-Control "no-store" always;
        return 204;
    }

    location /api/ {
        default_type application/json;
        if ($cookie_novel_ai_access != "__NOVEL_AI_WEB_SESSION_TOKEN__") {
            return 401 '{"detail":"AUTH_REQUIRED"}';
        }

        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    location /healthz {
        auth_basic off;
        proxy_pass http://$api_upstream/healthz;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location / {
        auth_basic off;
        try_files $uri $uri/ /index.html;
    }

    location @auth_failed {
        auth_basic off;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 401 '{"detail":"用户名或密码错误"}';
    }
}
